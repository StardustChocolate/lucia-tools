# 复制为 keystore.properties (该文件已被 .gitignore 忽略)，填入你自己的签名信息。
# App 必须与重打包后的游戏使用同一个 keystore 签名，才能 sharedUserId 同 uid。
# 生成示例：
#   keytool -genkeypair -v -keystore lucia.keystore -alias lucia \
#     -keyalg RSA -keysize 2048 -validity 36500 \
#     -storepass <PASS> -keypass <PASS> -dname "CN=lucia"
storeFile=../lucia.keystore
storePassword=changeme
keyAlias=lucia
keyPassword=changeme
